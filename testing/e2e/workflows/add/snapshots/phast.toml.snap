#:schema https://phast.sh/schema/v1/manifest.json
[package]
name = "acme/blog"
type = "project"

# Runtime dependencies, grouped by role.
[require]
php = "^8.4"

# HTTP stack.
"guzzlehttp/guzzle" = "^7.10"
"psr/log"           = "^3.0"
"symfony/console" = "^7.2"

[require-dev]
"phpunit/phpunit" = "^11.0"
"mockery/mockery" = "^1.6"

[config]
platform = { php = "8.4" }
