{
    "name": "acme/blog",
    "description": "A blog, before it moved to Phast.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "psr/log": "^3.0",
        "acme/markdown": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": { "Acme\\Blog\\": "src/" },
        "files": ["src/helpers.php"]
    },
    "autoload-dev": {
        "psr-4": { "Acme\\Blog\\Tests\\": "tests/" }
    },
    "repositories": [
        { "type": "path", "url": "packages/markdown" }
    ],
    "scripts": {
        "post-autoload-dump": ["@php -r \"echo 'dumped';\""],
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": { "sort-packages": true },
    "non-feature-branches": ["legacy/*"]
}
